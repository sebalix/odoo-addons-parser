<odoo>

    <!-- Root tags can be nested in data files
         (see 'odoo/tools/convert.py', method 'xml_import.parse()') -->
    <data>
        <openerp>
            <record id="partner_nested_in_data" model="res.partner">
                <field name="name">Nested Partner in Data</field>
            </record>
        </openerp>
    </data>

    <!-- Record tags can exist alongside nested root tags -->
    <record id="partner_alongside_root_tags" model="res.partner">
        <field name="name">Partner Alongside Root Tags</field>
    </record>

</odoo>
